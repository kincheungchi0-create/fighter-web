; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "HorNam"    ;Name of character
displayname = "HorNam" ;Name of character to display
versiondate = 09,30,2009    ;Version of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "spirit-clash OC"         ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 1280,720       ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = hornam.cmd        ;Command set
cns     = hornam.cns        ;Constants
st      = hornam.cns        ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = hornam.sff        ;Sprite
anim    = hornam.air        ;Animation
sound   = kfm.snd           ;Sound
ai      = hornam.ai         ;AI hints data (not used)
movelist = movelist.dat     ;Ikemen feature: Movelist

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 4
b = 5
c = 6
x2 = 7 ;Hold Start and press button X for palette 7, etc.
y2 = 8
z2 = 9
a2 = 10
b2 = 11
c2 = 12

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
